# Server-only values. Never use a NEXT_PUBLIC_ prefix.
# Save the ElevenLabs key and choose a voice in each game's /admin page.
AUDIO_ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional on Node: otherwise a persistent /data/audio/.master-key is created.
# Required on Cloudflare with D1 DB and R2 AUDIO bindings.
# AUDIO_MASTER_KEY=64-hexadecimal-characters
# PUBLIC_GAME_ORIGIN=https://your-public-game-origin
# Node voice (LiveKit Cloud or your existing self-hosted server).
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=your-server-key
# LIVEKIT_API_SECRET=your-server-secret
# LIVEKIT_DISABLED=true
